{
  "name": "promptd",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lightweight web UI to schedule, manage, and run Claude prompts",
  "license": "Apache-2.0",
  "main": "src/local.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').writeFileSync('dist/.built', new Date().toISOString())\"",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "node src/local.js",
    "dev": "node src/local.js --watch",
    "start:hub": "node src/server.js",
    "start:node": "node src/node.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "croner": "^9.0.0",
    "express": "^4.21.2",
    "kysely": "^0.29.6",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
